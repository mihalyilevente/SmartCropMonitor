&share
 wrf_core         = 'ARW',
 max_dom          = 1,
 start_date       = 'YYYY-MM-DD_HH:00:00',
 end_date         = 'YYYY-MM-DD_HH:00:00',
 interval_seconds = 10800,
 io_form_geogrid  = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 26,
 e_sn              = 26,
 geog_data_res     = 'default',
 dx                = 2000,
 dy                = 2000,
 map_proj          = 'lambert',
 ref_lat           = REF_LAT,
 ref_lon           = REF_LON,
 truelat1          = TRUELAT1,
 truelat2          = TRUELAT2,
 stand_lon         = STAND_LON,
 pole_lat          = 90.0,
 pole_lon          = 0.0,
 geog_data_path    = '/app/backend/data/storage/topo',
/

&ungrib
 out_format = 'WPS',
 prefix     = 'FILE',
/

&metgrid
 fg_name         = 'FILE',
 io_form_metgrid = 2,
/
